# 이 파일을 .env로 복사한 뒤 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다 (.gitignore에 포함)

# 서버 주소. 도메인이 없으면 서버 IP로 "1-2-3-4.sslip.io" 형태를 쓴다 (IP의 점을 -로)
DOMAIN=

# Anthropic 콘솔에서 발급한 키 (앱의 secrets.properties에 있던 CLAUDE_API_KEY와 같은 값)
CLAUDE_API_KEY=

# 아래는 기본값 그대로 두어도 된다
CLAUDE_ALLOWED_MODELS=claude-opus-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_REQUESTS_PER_HOUR=60
