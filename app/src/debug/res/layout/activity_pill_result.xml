<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        style="@style/MediMate.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/result_title" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:importantForAccessibility="no"
        android:indeterminate="true" />

    <!-- 진행 상황과 결과 안내 (서버의 ttsScript). TalkBack이 바뀔 때마다 읽는다 -->
    <TextView
        android:id="@+id/tvStatus"
        style="@style/MediMate.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:accessibilityLiveRegion="polite" />

    <TextView
        android:id="@+id/tvFeatures"
        style="@style/MediMate.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCandidates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/MediMate.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/result_retake" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            style="@style/MediMate.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/result_search" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        style="@style/MediMate.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/result_retry"
        android:visibility="gone" />

</LinearLayout>
