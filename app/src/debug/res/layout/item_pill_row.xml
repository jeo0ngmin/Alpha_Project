<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="88dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 카드 전체의 contentDescription으로 읽으므로 이미지 자체는 건너뛴다 -->
        <ImageView
            android:id="@+id/ivPill"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pill_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/MediMate.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/MediMate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvDetail"
                style="@style/MediMate.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#FF2E7D32"
            android:importantForAccessibility="no"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/candidate_mine"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
