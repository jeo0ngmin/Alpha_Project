<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- 복약 정보는 민감정보. Firestore에서 다시 받으므로 기기 백업에 넣지 않는다 (README 9-6) -->
    <cloud-backup>
        <exclude domain="database" path="medication.db" />
        <exclude domain="database" path="medication.db-shm" />
        <exclude domain="database" path="medication.db-wal" />
        <exclude domain="sharedpref" path="medication_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="medication.db" />
        <exclude domain="database" path="medication.db-shm" />
        <exclude domain="database" path="medication.db-wal" />
        <exclude domain="sharedpref" path="medication_session.xml" />
    </device-transfer>
</data-extraction-rules>