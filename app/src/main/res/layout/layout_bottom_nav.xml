<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/medimate_bg"
    android:elevation="6dp"
    android:gravity="center"
    android:orientation="horizontal">


    <!-- ========================= -->
    <!-- 홈 -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_home"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home_nav"
            app:tint="@color/medimate_nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_home"
            android:textColor="@color/medimate_nav_inactive"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- 복약알림 -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/nav_reminder"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_reminder"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_reminder"
            android:src="@drawable/ic_bell_nav"
            app:tint="@color/medimate_nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_reminder"
            android:textColor="@color/medimate_nav_inactive"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- 분석 -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/nav_analysis"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_analysis"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_analysis"
            android:src="@drawable/ic_analysis_nav"
            app:tint="@color/medimate_nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_analysis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_analysis"
            android:textColor="@color/medimate_nav_inactive"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- ========================= -->
    <!-- 챗봇 -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/nav_chatbot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_nav_chatbot"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:contentDescription="@string/nav_chatbot"
            android:src="@drawable/ic_chat_nav"
            app:tint="@color/medimate_nav_inactive" />

        <TextView
            android:id="@+id/tv_nav_chatbot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nav_chatbot"
            android:textColor="@color/medimate_nav_inactive"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>