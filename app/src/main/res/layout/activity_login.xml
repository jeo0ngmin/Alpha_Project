<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/medimate_bg">


    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/medimate_icon_green" />


    <!-- 화면 제목 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="로그인"
        android:textColor="@color/medimate_text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />


    <!-- 거북이 + 알약 로고 -->
    <ImageView
        android:id="@+id/img_login_logo"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_marginTop="52dp"
        android:contentDescription="@string/medimate_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_welcome_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back" />


    <!-- Medimate -->
    <TextView
        android:id="@+id/tv_medimate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Medimate"
        android:textColor="@color/medimate_sage_dark"
        android:textSize="29sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_login_logo" />


    <!-- 간편 로그인 -->
    <TextView
        android:id="@+id/tv_simple_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="간편 로그인"
        android:textColor="@color/medimate_text_sub"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_medimate" />


    <!-- Google 로그인 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="22dp"
        android:text="Google로 로그인하기"
        android:textAllCaps="false"
        android:textColor="@color/medimate_text_main"
        android:textSize="14sp"
        app:backgroundTint="@color/medimate_card"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_simple_login"
        app:strokeColor="@color/medimate_border"
        app:strokeWidth="1dp" />


    <!-- 카카오 로그인 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_kakao"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:text="카카오로 로그인하기"
        android:textAllCaps="false"
        android:textColor="#241817"
        android:textSize="14sp"
        app:backgroundTint="#FEE500"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@id/btn_google"
        app:layout_constraintStart_toStartOf="@id/btn_google"
        app:layout_constraintTop_toBottomOf="@id/btn_google" />


    <!-- 휴대폰 번호 로그인 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_phone"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:text="휴대폰 번호로 로그인"
        android:textAllCaps="false"
        android:textColor="@color/medimate_sage_dark"
        android:textSize="14sp"
        app:backgroundTint="@color/medimate_sage_soft"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@id/btn_google"
        app:layout_constraintStart_toStartOf="@id/btn_google"
        app:layout_constraintTop_toBottomOf="@id/btn_kakao" />


    <!-- 회원가입 -->
    <LinearLayout
        android:id="@+id/layout_signup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_phone">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아직 계정이 없으신가요?"
            android:textColor="@color/medimate_text_sub"
            android:textSize="13sp" />


        <TextView
            android:id="@+id/tv_signup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="회원가입"
            android:textColor="@color/medimate_sage_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>