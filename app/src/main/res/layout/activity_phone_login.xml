<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phone_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.PhoneLoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/login_phone"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:autofillHints="phone"
            android:hint="@string/phone_input_hint"
            android:inputType="phone"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button_send_code"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:text="@string/phone_send_code"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/input_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="64dp"
            android:autofillHints="smsOTPCode"
            android:hint="@string/phone_code_hint"
            android:inputType="number"
            android:maxLength="6"
            android:textSize="24sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_verify_code"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:text="@string/phone_verify_code"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_phone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="20sp" />

    </LinearLayout>
</ScrollView>
