<?xml version="1.0" encoding="utf-8"?>
<!--
    [JE 화면] 복약알림.
    위쪽 달력 카드에서 날짜를 고르면 그날의 복용 회차를 보여 준다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reminder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/medimate_bg"
    tools:context=".MedicationReminderActivity">


    <!-- ========================= -->
    <!-- 전체 스크롤 영역 -->
    <!-- ========================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/reminder_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/include_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">


            <!-- ========================= -->
            <!-- 상단 제목 -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:minHeight="50dp"
                android:text="@string/reminder_screen_title"
                android:textColor="@color/medimate_text_main"
                android:textSize="25sp"
                android:textStyle="bold" />


            <LinearLayout
                android:id="@+id/reminder_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- ========================= -->
                <!-- 달력 카드 -->
                <!-- ========================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="@color/medimate_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/medimate_border"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="12dp">


                        <!-- 월 이동 / 오늘 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <!-- 이전 -->
                            <ImageButton
                                android:id="@+id/button_previous"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/schedule_previous_week_desc"
                                android:src="@drawable/ic_chevron_left"
                                app:tint="@color/medimate_sage_dark" />


                            <!-- 월 표시 -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_month"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:minHeight="48dp"
                                android:textColor="@color/medimate_text_main"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_expand_more"
                                app:iconGravity="textEnd"
                                app:iconTint="@color/medimate_sage_dark"
                                tools:text="2026년 11월" />


                            <!-- 다음 -->
                            <ImageButton
                                android:id="@+id/button_next"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/schedule_next_week_desc"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/medimate_sage_dark" />


                            <!-- 오늘 -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_today"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:minHeight="48dp"
                                android:text="@string/schedule_today"
                                android:textColor="@color/medimate_sage_dark"
                                android:textSize="14sp"
                                app:backgroundTint="@color/medimate_card"
                                app:cornerRadius="15dp"
                                app:strokeColor="@color/medimate_sage"
                                app:strokeWidth="1dp" />

                        </LinearLayout>


                        <!-- 요일 -->
                        <LinearLayout
                            android:id="@+id/weekday_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:visibility="gone" />


                        <!-- 달력 -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_calendar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================= -->
                <!-- 알림 권한 안내 -->
                <!-- ========================= -->

                <LinearLayout
                    android:id="@+id/alarm_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_notice_banner"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">


                    <TextView
                        android:id="@+id/text_alarm_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dose_check_on"
                        android:textSize="16sp"
                        tools:text="@string/schedule_exact_alarm_needed" />


                    <Button
                        android:id="@+id/button_alarm_banner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:text="@string/schedule_open_settings"
                        android:textSize="16sp" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- 동기화 안내 -->
                <!-- ========================= -->

                <LinearLayout
                    android:id="@+id/sync_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_notice_banner"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">


                    <TextView
                        android:id="@+id/text_sync_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/dose_check_on"
                        android:textSize="16sp"
                        tools:text="동기화 대기 1건" />


                    <Button
                        android:id="@+id/button_sync_banner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:text="@string/schedule_sync_retry"
                        android:textSize="16sp" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- 선택한 날짜의 복용 일정 -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical">


                    <!-- 제목 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/reminder_selected_title"
                        android:textColor="@color/medimate_text_main"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <!-- 날짜 / 복용 완료 요약 -->
                    <TextView
                        android:id="@+id/tv_selected_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/medimate_text_sub"
                        android:textSize="13sp"
                        tools:text="11월 10일 화요일 · 3회 중 1회 완료" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- 복용 회차 목록 -->
                <!-- ========================= -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_doses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- 일정 없음 -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/text_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_soft"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/schedule_empty"
                android:textColor="@color/medimate_text_sub"
                android:textSize="15sp"
                android:visibility="gone" />


            <!-- ========================= -->
            <!-- 복용 알림 추가 -->
            <!-- ========================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_med_schedule"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="22dp"
                android:text="@string/reminder_add"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/medimate_sage"
                app:cornerRadius="17dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================= -->
    <!-- 하단 네비게이션 -->
    <!-- ========================= -->

    <include
        android:id="@+id/include_bottom_nav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>