<?xml version="1.0" encoding="utf-8"?>

<!--
    복약알림 한 회차 카드
    JE 스타일: 흰 카드 + 연한 테두리 + 세이지 포인트
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:minHeight="94dp"
    app:cardBackgroundColor="@color/medimate_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/medimate_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="94dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">


        <!-- 카드 본문 -->
        <LinearLayout
            android:id="@+id/dose_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="70dp"
            android:orientation="horizontal"
            android:paddingEnd="4dp">


            <!-- 약 아이콘 -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/image_pill"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_capsule"
                    app:tint="@color/medimate_sage_dark" />

            </FrameLayout>


            <!-- 약 정보 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">


                <!-- 약 이름 -->
                <TextView
                    android:id="@+id/text_dose_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="@color/medimate_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="타이레놀정500밀리그람" />


                <!-- 시간 / 복용량 -->
                <TextView
                    android:id="@+id/text_dose_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/medimate_text_sub"
                    android:textSize="13sp"
                    tools:text="오전 8:00 · 1회 1정" />


                <!-- 복용 상태 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/image_status"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/medimate_text_sub" />

                    <TextView
                        android:id="@+id/text_dose_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/medimate_text_sub"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="복용 예정" />

                </LinearLayout>


                <!-- 동기화 / 알림 상태 -->
                <TextView
                    android:id="@+id/text_dose_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/medimate_text_sub"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="동기화 대기"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>


        <!-- 더보기 -->
        <ImageButton
            android:id="@+id/button_dose_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/medimate_text_sub"
            tools:ignore="ContentDescription" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>