<?xml version="1.0" encoding="utf-8"?>
<!-- 알약 모양 복약 버튼. 본문을 누르면 복용 체크, 더보기는 일정 수정·삭제로 분리한다.
     글자를 키워도 잘리지 않게 줄 수 제한 없이 세로로 늘어난다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dose_pill"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/dose_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/image_pill"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pill" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_dose_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="타이레놀정500밀리그람" />

            <TextView
                android:id="@+id/text_dose_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="18sp"
                tools:text="오전 8:00 · 1회 1정" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_status"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_schedule" />

                <TextView
                    android:id="@+id/text_dose_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="복용 예정" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_dose_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="동기화 대기"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/button_dose_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        tools:ignore="ContentDescription" />

</LinearLayout>
