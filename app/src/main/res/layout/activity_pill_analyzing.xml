<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/medimate_bg">

    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/medimate_icon_green" />

    <!-- 화면 제목 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/pill_capture_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <!-- 분석 대상 사진 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_analysis_image"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="58dp"
        app:cardBackgroundColor="@color/medimate_icon_background"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/img_analysis_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/pill_image"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <!-- 로딩 표시 -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_analysis"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="34dp"
        android:indeterminate="true"
        app:indicatorColor="@color/medimate_icon_green"
        app:indicatorSize="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_analysis_image"
        app:trackColor="@color/medimate_icon_background"
        app:trackThickness="5dp" />

    <!-- 분석 안내 제목 -->
    <TextView
        android:id="@+id/tv_analysis_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/pill_analyzing_headline"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_analysis" />

    <!-- 분석 안내 설명 -->
    <TextView
        android:id="@+id/tv_analysis_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="42dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/pill_analyzing_description"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_analysis_headline" />

    <!-- 분석 취소 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_analysis"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="34dp"
        android:text="@string/cancel_analysis"
        android:textColor="@color/medimate_icon_green"
        android:textSize="15sp"
        app:backgroundTint="@color/white"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/medimate_icon_green"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>