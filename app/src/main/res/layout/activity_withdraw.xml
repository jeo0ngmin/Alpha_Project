<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/medimate_bg">


    <!-- ========================= -->
    <!-- 뒤로가기 -->
    <!-- ========================= -->

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/medimate_icon_green" />


    <!-- ========================= -->
    <!-- 제목 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="회원 탈퇴"
        android:textColor="@color/medimate_text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />


    <!-- 기존 Java 코드 호환용 -->
    <TextView
        android:id="@+id/btn_close"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ========================= -->
    <!-- 경고 아이콘 -->
    <!-- ========================= -->

    <FrameLayout
        android:id="@+id/warning_container"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginTop="76dp"
        android:background="@drawable/bg_icon_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/medimate_sage_dark"
            android:textSize="38sp"
            android:textStyle="bold" />

    </FrameLayout>


    <!-- ========================= -->
    <!-- 경고 제목 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/tv_warning_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Medimate 계정을 탈퇴하시겠습니까?"
        android:textColor="@color/medimate_text_main"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/warning_container" />


    <!-- ========================= -->
    <!-- 경고 설명 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/tv_warning_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="탈퇴하시면 모든 데이터가 삭제되며,&#10;이후 다시 복구할 수 없습니다."
        android:textColor="@color/medimate_text_sub"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_warning_title" />


    <!-- ========================= -->
    <!-- 탈퇴 버튼 -->
    <!-- ========================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_withdraw"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="22dp"
        android:text="Medimate 탈퇴하기"
        android:textAllCaps="false"
        android:textColor="#A45B5B"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/medimate_card"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_warning_description"
        app:strokeColor="#D7B1B1"
        app:strokeWidth="1dp" />


    <!-- ========================= -->
    <!-- 취소 버튼 -->
    <!-- ========================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:text="취소"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/medimate_sage"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_withdraw" />


</androidx.constraintlayout.widget.ConstraintLayout>