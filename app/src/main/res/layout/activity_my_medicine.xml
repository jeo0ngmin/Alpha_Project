<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/medimate_bg">


    <!-- ========================= -->
    <!-- 뒤로가기 -->
    <!-- ========================= -->

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/medimate_icon_green" />


    <!-- ========================= -->
    <!-- 화면 제목 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="내 약"
        android:textColor="@color/medimate_text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />


    <!-- ========================= -->
    <!-- 등록된 약 요약 카드 -->
    <!-- ========================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_my_medicine_summary"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="22dp"
        app:cardBackgroundColor="@color/medimate_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/medimate_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">


            <!-- 알약 아이콘 -->
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:contentDescription="내 약"
                    android:src="@drawable/ic_capsule" />

            </FrameLayout>


            <!-- 안내 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="현재 복용 중인 약"
                    android:textColor="@color/medimate_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="등록된 약 정보를 한눈에 확인하세요"
                    android:textColor="@color/medimate_text_sub"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- 약 개수 -->
            <TextView
                android:id="@+id/tv_my_medicine_count"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:minWidth="54dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="2개"
                android:textColor="@color/medimate_sage_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ========================= -->
    <!-- 목록 제목 -->
    <!-- ========================= -->

    <TextView
        android:id="@+id/tv_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="26dp"
        android:fontFamily="sans-serif-medium"
        android:text="복용 중인 약"
        android:textColor="@color/medimate_text_main"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_my_medicine_summary" />


    <!-- ========================= -->
    <!-- 약 목록 -->
    <!-- ========================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_my_medicine"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="22dp"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toBottomOf="@id/tv_list_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="2"
        tools:listitem="@layout/item_medicine" />


</androidx.constraintlayout.widget.ConstraintLayout>