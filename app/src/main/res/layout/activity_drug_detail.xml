<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drug_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.drug.DrugDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="타이레놀정500밀리그람(아세트아미노펜)" />

        <Button
            android:id="@+id/button_speak_all"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="@string/detail_speak_all"
            android:textSize="20sp" />

        <include
            android:id="@+id/section_dosage"
            layout="@layout/section_drug_detail" />

        <include
            android:id="@+id/section_storage"
            layout="@layout/section_drug_detail" />

        <include
            android:id="@+id/section_description"
            layout="@layout/section_drug_detail" />

        <include
            android:id="@+id/section_warning"
            layout="@layout/section_drug_detail" />

    </LinearLayout>
</ScrollView>
