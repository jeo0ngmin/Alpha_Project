<?xml version="1.0" encoding="utf-8"?>

<!--
    알림 시간 선택
    MaterialAlertDialog 내부에 들어가는 콘텐츠 영역.
    JE 스타일에 맞춰 여백과 세이지 톤만 살리고,
    별도의 카드 박스는 만들지 않는다.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">


    <!-- 안내 문구 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="복용 시간을 선택해 주세요"
        android:textColor="@color/medimate_text_main"
        android:textSize="15sp"
        android:textStyle="bold" />


    <!-- 보조 안내 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="오전·오후 / 시 / 분"
        android:textColor="@color/medimate_text_sub"
        android:textSize="12sp" />


    <!-- 시간 선택 휠 -->
    <TimePicker
        android:id="@+id/time_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:scaleX="1.15"
        android:scaleY="1.15"
        android:theme="@style/Medimate.TimePickerTheme"
        android:timePickerMode="spinner" />


    <!-- 사용 방법 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="위아래로 움직여 시간을 맞춰 주세요"
        android:textColor="@color/medimate_text_sub"
        android:textSize="12sp" />

</LinearLayout>